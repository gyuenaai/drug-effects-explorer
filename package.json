{
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "description": "Lightweight educational explorer for common drug effects and interactions",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "name": "drug-effects-explorer",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3000",
    "nest:build": "npm run build",
    "pm2:start": "pm2 start npm --name drug-explorer -- start",
    "pm2:stop": "pm2 stop drug-explorer",
    "serve:static": "python3 server.py",
    "start": "next start -p 3000"
  },
  "version": "1.0.0"
}